<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.github.mzehetmeyr.javabooleananalyzer.MainController">
  <padding>
    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
  </padding>

  <Label text="Analisador de Expressão Booleana" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>

  <!-- Campo para digitar a expressão -->
  <TextField fx:id="expressionInput" promptText="Digite a expressão"/>

  <!-- Botão de ação -->
  <Button text="Analisar Tabela Verdade" onAction="#onAnalyzeButtonClick"/>
</VBox>